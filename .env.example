# Keep test and production projects separate. Never commit populated env files.
APP_MODE=test
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
PROTON_SMTP_HOST=smtp.protonmail.ch
PROTON_SMTP_PORT=587
PROTON_SMTP_USER=
PROTON_SMTP_TOKEN=
EMAIL_FROM=ProAcademy <portal@example.com>
MAIL_PROVIDER=capture
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=
# Optional comma-separated own login accounts; does not widen notification delivery.
AUTH_TEST_EMAILS=
WHATSAPP_NUMBER=4915143342392
PARENT_CANCELLATION_ENABLED=false
REPORT_SEND_TIME=08:00
CRON_SECRET=
JOB_RUNNER_URL=http://127.0.0.1:3001
JOB_RUNNER_PORT=3001
JOBS_ENABLED=false
# Restricted background processing; never starts mail, reports or attendance.
STRIPE_SYNC_ONLY=false
# Optional external contract tests write synthetic data to a disposable TEST project.
# Set explicitly only after reading scripts/test-external.ts and docs/ACCEPTANCE.md.
EXTERNAL_TESTS_CONFIRM=
SUPABASE_ENVIRONMENT=test

# pAi: local tests require loopback Supabase; no production fallback to test key.
# Global switch: platform_features row key=pai (defaults disabled).
PAI_TEST_API_KEY=
PAI_PRODUCTION_API_KEY=
PAI_PRODUCTION_CONFIRMED=false
# STOPP: Vor Veröffentlichung den neuen offiziellen pAi-Produktions-API-Schlüssel hinterlegen und bestätigen!

# Probetraining: enable only with SQL 017 in the intended environment.
TRIAL_TRAINING_ENABLED=false

# Product management installation; storefront is a separate Super-Admin database switch.
PRODUCT_MANAGEMENT_ENABLED=false
PRODUCT_PAYMENTS_ENABLED=false
# Dedicated restricted key, matching APP_MODE: test locally, live in production.
# Production can otherwise reuse STRIPE_SECRET_KEY; its write permissions must be verified.
PRODUCT_STRIPE_SECRET_KEY=
# Optional dedicated webhook; production also accepts the existing signed Stripe webhook.
PRODUCT_STRIPE_WEBHOOK_SECRET=
