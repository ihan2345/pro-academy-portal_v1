# Preparation only: do not load these settings into an existing deployment automatically.
CAMP_LOCAL_ENABLED=false
CAMP_DEPLOYMENT_ENABLED=false
CAMP_PUBLIC_ORIGIN=
CAMP_STRIPE_MODE=test
CAMP_LIVE_PAYMENTS_ENABLED=false
CAMP_STRIPE_SECRET_KEY=
# Camp code itself does not send invitations or schedule jobs.
# Existing portal mail/worker settings must not be changed by a Camp release.
# Dedicated Camp review/processing; existing JOBS_ENABLED/STRIPE_SYNC_ONLY stay unchanged.
CAMP_REVIEW_ENABLED=false
CAMP_PROCESSING_ENABLED=false
CAMP_STRIPE_READ_KEY=
CAMP_STRIPE_WEBHOOK_SECRET=
# Required only on the explicitly released server, never in the local launcher:
# NODE_ENV=production
# CAMP_SIDE_EFFECTS_BLOCKED=false
# Run separately: npm run camp:worker (or scheduled invocation with -- --once).
