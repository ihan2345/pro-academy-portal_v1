import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { notFound } from 'next/navigation';
import { serviceDb } from '@/lib/server/service-db';
export const dynamic='force-dynamic';
export default async function LocalAccounts() {
 if(process.env.LOCAL_FAMILY_TEST!=='true' || process.env.NEXT_PUBLIC_SUPABASE_URL!=='http://127.0.0.1:55321') notFound();
 const state=JSON.parse(readFileSync(resolve('../accounts.private.json'),'utf8'));
 const accounts=state.accounts.sort((a:any,b:any)=>a.role==='admin'?-1:b.role==='admin'?1:b.children.length-a.children.length||a.name.localeCompare(b.name,'de'));
 let trials:any[]=[];
 if(process.env.TRIAL_TRAINING_ENABLED==='true') {
  const {data,error}=await serviceDb().from('trial_families').select('id,parent_name,email,email_verified_at,auth_user_id,trial_players(first_name,last_name,converted_player_id)').is('stopped_at',null).order('created_at',{ascending:false});
  if(error)throw new Error('Lokale Probetraining-Konten konnten nicht geladen werden.');
  trials=data??[];
 }
 return <main style={{maxWidth:1100,margin:'30px auto',padding:20}}><h1>Lokaler Kontowechsel</h1><p>Änderungen werden nur in dieser lokalen Datenbank gespeichert. Kein Mailversand und keine Verbindung zu Stripe.</p>
 {!!trials.length&&<section style={{margin:'24px 0'}}><h2 style={{fontSize:24,marginBottom:12}}>Neue Probetraining-Elternkonten</h2><p>Diese Liste lädt deine neuen Anfragen direkt aus der lokalen Datenbank. Nach bestätigter E-Mail kannst du das Elternkonto direkt öffnen. Bei offenen Bestätigungen öffnet sich zuerst der persönliche Willkommenszugang.</p><div style={{display:'grid',gridTemplateColumns:'repeat(auto-fit,minmax(270px,1fr))',gap:16,marginTop:16}}>{trials.map(f=><form key={f.id} method="post" action="/lokaler-test/session" style={{padding:20,border:'1px solid #97E9E5',borderTop:'6px solid #97E9E5',borderRadius:12,background:'white'}}><input type="hidden" name="account" value={`trial:${f.id}`}/><h3 style={{fontSize:19,fontWeight:700}}>{f.parent_name}</h3><p style={{overflowWrap:'anywhere'}}>{f.email}</p><p>{f.trial_players.map((p:any)=>`${p.first_name} ${p.last_name}`).join(' · ')}</p><p style={{margin:'10px 0'}}>{f.email_verified_at?'E-Mail bestätigt':'E-Mail-Bestätigung ausstehend'}{f.trial_players.some((p:any)=>p.converted_player_id)?' · Abo übernommen':''}</p><button style={{padding:'10px 14px',background:'#97E9E5',borderRadius:8,color:'#173b3a',fontWeight:700}} type="submit">{f.email_verified_at?'Elternkonto öffnen':'Willkommenszugang öffnen'}</button></form>)}</div></section>}
 <h2 style={{fontSize:24,margin:'28px 0 12px'}}>Bestehende Testkonten</h2><p>84 Elternkonten · 91 Kinder · Datenstand 12.09.2026. Wähle die Verwaltung oder ein Elternkonto. Die Elternansicht verwendet eine echte lokale Anmeldung mit den normalen Zugriffsrechten.</p><p>Menzur: ein FirstTouch-Abo mit 4 Einheiten. Sevgi: ein gemeinsames Elternkonto für beide Kinder. Vorhandene Trainingstermine und Berichte wurden nicht importiert.</p><div style={{display:'grid',gridTemplateColumns:'repeat(auto-fit,minmax(270px,1fr))',gap:16,marginTop:16}}>{accounts.map((a:any)=><form key={a.key} method="post" action="/lokaler-test/session" style={{padding:20,border:'1px solid #ccc',borderRadius:12}}><input type="hidden" name="account" value={a.key}/><h2 style={{fontSize:19}}>{a.name}</h2><p>{a.role==='admin'?'Verwaltung':a.role==='staff'?'Trainingsplanung':a.children.join(' · ')}</p><button type="submit">{a.role==='admin'?'Verwaltung öffnen':a.role==='staff'?'Teamansicht öffnen':'Elternkonto öffnen'}</button></form>)}</div></main>;
}
