import { readdirSync,readFileSync,existsSync } from 'node:fs';
import { notFound } from 'next/navigation';
import { serviceDb } from '@/lib/server/service-db';
export const dynamic='force-dynamic';
export default async function LocalTrials() {
 if(process.env.LOCAL_FAMILY_TEST!=='true'||process.env.NEXT_PUBLIC_SUPABASE_URL!=='http://127.0.0.1:55321')notFound();
 const db=serviceDb();const {data:rows,error}=await db.from('trial_team_overview').select('*').order('created_at',{ascending:false});if(error)throw error;
 const mail=existsSync('output/mail')?readdirSync('output/mail').filter(f=>f.endsWith('.json')).map(f=>JSON.parse(readFileSync('output/mail/'+f,'utf8'))).reverse():[];
 const button={padding:"9px 14px",border:"1px solid #718096",borderRadius:8,background:"#fff",color:"#111827"};
 const box={padding:20,border:'1px solid #718096',borderRadius:12,marginBottom:16};
 return <main style={{maxWidth:1100,margin:'30px auto',padding:20}}>
 <h1>Probetraining · lokaler Test</h1><p>Eigene lokale Datenbank · Mails werden nur hier gespeichert · keine Zahlungen</p>
 <p style={{textDecoration:"underline",lineHeight:2}}><a href="/probetraining" target="_blank">1. Neues Probetraining anfragen ↗</a> · <a href="/lokaler-test" target="_blank">2. Verwaltung / Elternkonto wechseln ↗</a> · <a href="/admin/probetraining" target="_blank">3. Anfragen und Bewertungen ↗</a></p>
 <ol style={{listStyle:"decimal",paddingLeft:22,margin:"18px 0",lineHeight:1.8}}><li>Formular mit frei erfundenen Namen und einer neuen Test-E-Mail ausfüllen, z. B. familie-test-1@example.invalid.</li><li>Hier „Mails aktualisieren“ klicken, die Willkommensmail unten öffnen und den Portal-Link bestätigen.</li><li>Über den Kontowechsel die Verwaltung öffnen. Unter „Probetraining“ den lokalen Testtermin zuordnen.</li><li>Hier „Teilnahme simulieren“ wählen. Danach in der Verwaltung das Coachfeedback eintragen und freigeben.</li><li>„24 Stunden später“ wählen: Die Feedbackmail erscheint unten. Elternfeedback im verlinkten Willkommensportal abgeben. Anschließend 7 und 14 Tage simulieren.</li></ol>
 <p>Für die Angebotsfolge im Formular die optionale Marketingeinwilligung auswählen. Termine und Bewertungen speichert die echte Anwendung. Die Zeitknöpfe verändern ausschließlich diesen lokalen Test. Nach Änderungen in einem anderen Tab diese Seite neu laden.</p>
 <form method="post" action="/lokaler-test/probetraining/action"><button style={button} name="stage" value="mail">Mails aktualisieren</button></form>
 <h2 style={{fontSize:22,margin:"22px 0 12px"}}>Testanfragen</h2>{rows?.map(r=><section key={r.id} style={box}><h3>{r.first_name} {r.last_name}</h3><p>{r.parent_name} · {r.email} · {({new:"Neu",contacted:"Kontakt aufgenommen",planned:"Geplant",attended:"Teilnahme bestätigt",closed:"Abgeschlossen"} as Record<string,string>)[r.status]??r.status}</p><p>{r.event_title??'Noch kein Termin'} · Coachfeedback: {r.academy_ready?'freigegeben':'offen'} · Elternbewertung: {r.parent_rating??'offen'}</p><form method="post" action="/lokaler-test/probetraining/action" style={{display:'flex',gap:10,flexWrap:'wrap'}}><input type="hidden" name="request" value={r.id}/><button style={button} name="stage" value="attend" disabled={!r.event_id||!!r.confirmed_at}>Teilnahme simulieren</button><button style={button} name="stage" value="day1" disabled={!r.confirmed_at}>24 Stunden später</button><button style={button} name="stage" value="day7" disabled={!r.confirmed_at}>7 Tage später</button><button style={button} name="stage" value="day14" disabled={!r.confirmed_at}>14 Tage später</button></form></section>)}
 <h2 style={{fontSize:22,margin:"22px 0 12px"}}>Lokaler Mailausgang ({mail.length})</h2>{mail.length===0&&<p>Noch keine Mails. Nach der Anfrage oben „Mails aktualisieren“ klicken.</p>}{mail.map((m,i)=><details key={i} style={box}><summary><b>{m.subject}</b> · {m.to}</summary><pre style={{whiteSpace:'pre-wrap',overflowWrap:'anywhere',fontFamily:'inherit'}}>{m.text}</pre>{Array.from(new Set<string>((m.text as string).match(/http:\/\/127\.0\.0\.1:3107\/[^\s]+/g)??[])).map(url=><p key={url}><a href={url} target="_blank">Willkommensportal / Bewertung öffnen ↗</a></p>)}</details>)}
 </main>;
}
