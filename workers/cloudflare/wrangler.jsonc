{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "proacademy-jobs",
  "account_id": "7300475f02c8b8793bb7e6250d0d4690",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "ProAcademyRunner",
      "image": "../Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "RUNNER", "class_name": "ProAcademyRunner" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProAcademyRunner"] }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "APP_URL": "https://proacademy-portal.proacademy-by-ak.workers.dev",
    "APP_MODE": "production",
    "JOBS_ENABLED": "false",
    "STRIPE_SYNC_ONLY": "true",
    "ACCEPTANCE_TEST_ENABLED": "false",
    "MAIL_PROVIDER": "capture",
    "EMAIL_TEST_MODE": "true",
    "EMAIL_TEST_RECIPIENT": "ayh.kaan@icloud.com",
    "EMAIL_FROM": "ProAcademy <billing@proacademy-ak.com>",
    "PROTON_SMTP_HOST": "smtp.protonmail.ch",
    "PROTON_SMTP_PORT": "587",
    "PROTON_SMTP_USER": "billing@proacademy-ak.com",
    "REPORT_SEND_TIME": "08:00",
    "WHATSAPP_NUMBER": "4915143342392",
  },
}
