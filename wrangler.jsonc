{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proacademy-portal-test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_MODE": "test",
    "PARENT_CANCELLATION_ENABLED": "false",
    "EMAIL_TEST_MODE": "true",
  },
  "env": {
    "production": {
      "name": "proacademy-portal",
      "account_id": "7300475f02c8b8793bb7e6250d0d4690",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "portal.proacademy-ak.com", "custom_domain": true },
      ],
      "services": [{ "binding": "MAIL_RUNNER", "service": "proacademy-jobs" }],
      "vars": {
        "APP_MODE": "production",
        "LOCAL_PROFILE_STRIPE_READ": "false",
        "PAI_PRODUCTION_CONFIRMED": "true",
        "APP_URL": "https://portal.proacademy-ak.com",
        "NEXT_PUBLIC_APP_URL": "https://portal.proacademy-ak.com",
        "SUPABASE_ENVIRONMENT": "production",
        "JOB_RUNNER_URL": "https://proacademy-jobs.proacademy-by-ak.workers.dev",
        "PARENT_CANCELLATION_ENABLED": "false",
        "EMAIL_TEST_MODE": "false",
        "EMAIL_TEST_RECIPIENT": "ayh.kaan@icloud.com",
        "AUTH_TEST_EMAILS": "ayh.kaan@googlemail.com,proacademy.by.ak@gmail.com,contact@kaanayhan.de",
        "MAIL_PROVIDER": "proton",
        "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1UDrgZRoswKHkM76cERxORbx",
        "MANUAL_INVITATIONS_ENABLED": "true",
        "CAMP_DEPLOYMENT_ENABLED": "true",
        "CAMP_PUBLIC_ORIGIN": "https://portal.proacademy-ak.com",
        "CAMP_STRIPE_MODE": "live",
        "CAMP_LIVE_PAYMENTS_ENABLED": "true",
        "CAMP_REVIEW_ENABLED": "true",
        "CAMP_PROCESSING_ENABLED": "true",
        "CAMP_SIDE_EFFECTS_BLOCKED": "false",
      },
      "ratelimits": [
        {
          "name": "CAMP_REQUEST_LIMIT",
          "namespace_id": "20260918",
          "simple": {
            "limit": 20,
            "period": 60,
          },
        },
      ],
    },
  },
}
